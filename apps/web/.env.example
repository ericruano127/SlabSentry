# --- Database (Supabase Postgres connection string, or local Postgres) ---
DATABASE_URL=postgres://postgres@localhost:5432/slabguard

# --- Auth (Supabase). AUTH_MODE=dev enables a local dev login; refused when NODE_ENV=production ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=            # optional (legacy HS256); otherwise JWKS is used
AUTH_MODE=
NEXT_PUBLIC_AUTH_MODE=
ADMIN_EMAILS=                   # comma-separated

# --- Storage (Supabase private bucket; local disk when Supabase isn't configured) ---
STORAGE_BUCKET=slab-images
LOCAL_STORAGE_DIR=

# --- Vision service ---
VISION_URL=http://localhost:8001
VISION_API_KEY=

# --- Optional integrations (features show "not configured" when empty) ---
PSA_API_TOKEN=                  # PSA Public API bearer token (free tier: 100 calls/day)
GOOGLE_VISION_API_KEY=          # Cloud Vision Web Detection (reverse image)
ANTHROPIC_API_KEY=              # AI-assisted report explanations (Pro+); rule-based summary when empty
ANTHROPIC_MODEL=claude-opus-5-5
MAX_VIDEO_BYTES=                # tilt video upload limit (default 60 MB)

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=         # Stripe price ids mapped to config/plans.json price ids
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_POWER_MONTH=
STRIPE_PRICE_POWER_YEAR=
REVENUECAT_WEBHOOK_AUTH=        # exact Authorization header value configured in RevenueCat
REVENUECAT_SECRET_API_KEY=      # enables server-side reconciliation / restore purchases
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Phase C ---
CERT_HASH_SECRET=               # ≥32 random chars; keys the pseudonymous cloned-cert index (required in production)
PRICECHARTING_TOKEN=            # optional; also enable + verify mapping in config/fmv.json first

# --- Quality ---
MISSED_FAKE_WEIGHT=5            # cost of a missed fake relative to a false flag in accuracy metrics and the release gate

# --- Privacy & security ---
RETENTION_MEDIA_DAYS=365        # originals + derived media deleted after this many days (worker runs every 6h)
MAX_IMAGE_PIXELS=50000000       # decompression-bomb guard
MAX_IMAGE_SIDE=12000
ALLOW_UNREVIEWED_LEGAL=         # 1 only for staging: production refuses to start while legal docs await review

# --- Ops ---
INLINE_WORKER=                  # 1 = process jobs inside the web process (default in dev)

# --- Phase F: scale & operations ---
REDIS_URL=                      # redis://… shared rate limits + PSA quota across instances (falls back to Postgres if unset/unreachable)
PSA_DAILY_LIMIT=100             # PSA API calls/day for the whole deployment (2 calls per lookup); over → partial report
PSA_PER_SECOND=2                # global PSA throttle
DB_POOL_MAX=10                  # connections per process; size so (web pods + workers) × pool ≤ Postgres/PgBouncer limit
DB_STATEMENT_TIMEOUT_MS=15000
METRICS_TOKEN=                  # bearer token for /api/metrics (Prometheus); unset = metrics disabled in production
ALERT_WEBHOOK_URL=              # optional; 5xx and job failures posted here (throttled per error)
SERVICE_NAME=slabguard-web      # label in JSON logs
# vision service: VISION_THREADS=2  (match OpenCV threads to the container CPU limit)
