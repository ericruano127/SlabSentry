# Settings for the test environment on your own computer (docs/LOCAL_STAGING.md).
# Copy this file to `.env` in the same folder and fill it in. `.env` is ignored by git: never commit it,
# and never paste its contents into chat.

# ---- ngrok (free fixed public address) ----
# Your free static domain from the ngrok dashboard (Domains), without https://
NGROK_DOMAIN=your-name.ngrok-free.app
# ngrok dashboard → Your Authtoken
NGROK_AUTHTOKEN=

# The public address testers use. Must match NGROK_DOMAIN.
APP_URL=https://your-name.ngrok-free.app

# ---- Supabase (free project for sign-in and photo storage) ----
# Project Settings → API (or Data API / API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Secret: server only. Never put this in the mobile app or a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Project Settings → JWT. Leave empty to verify sign-ins with the project's public keys.
SUPABASE_JWT_SECRET=

# ---- You ----
# Your email: the first account with it becomes the staff owner (staff tools need two-factor).
ADMIN_EMAILS=you@example.com

# ---- Generate these once (long random values) ----
# In PowerShell, run this once per value and paste the result (64 random characters):
#   [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
VISION_API_KEY=
CERT_HASH_SECRET=

# ---- Optional ----
# Stripe TEST-mode keys (sk_test_..., whsec_...) to try upgrades; webhook URL is APP_URL/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PSA cert lookups
PSA_API_TOKEN=
# AI plain-language explanations (Pro feature)
ANTHROPIC_API_KEY=
